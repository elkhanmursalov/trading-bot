# Backend settings. Copy to .env (same folder) and fill in; .env is git-ignored.
# On Railway, set the same names as service variables instead.

# Binance Spot Testnet keys (https://testnet.binance.vision). Required.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# off = API only, dry_run = decide without orders, testnet = send testnet orders.
# Only one place (Railway, local backend or notebook bot) may run testnet at a time.
BOT_MODE=off

# Browser origins allowed to read the API, comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:5173

# Optional strategy settings (defaults shown).
SYMBOL=BTCUSDT
INTERVAL=1h
TRADE_SIZE_USDT=100
